{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "../functions",
      "codebase": "elwataniatv-functions",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "hosting-dist",
    "predeploy": [
      "node ../scripts/build-hosting.js"
    ],
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/admin/index.html"
      },
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/admin/",
        "destination": "/admin/index.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/privacy/",
        "destination": "/privacy.html"
      },
      {
        "source": "/download",
        "destination": "/download.html"
      },
      {
        "source": "/download/",
        "destination": "/download.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
